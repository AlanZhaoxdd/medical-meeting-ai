APP_ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

POSTGRES_PASSWORD=medical
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password-32chars
MINIO_BUCKET=medical-kb
MILVUS_COLLECTION=medical_kb_records

MAX_UPLOAD_BYTES=52428800
MEETING_IMPORT_STALE_SECONDS=3600
CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100
CHUNK_SIMILARITY_THRESHOLD=0.65

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-1a242e22da0c41f88042e1293901d865
LLM_MODEL=deepseek-v4-flash
# Optional provider-specific fallback; do not commit the key.
DEEPSEEK_API_KEY=
# 会议问答 Agent：LLM 先路由问题再执行（检索/通用回答/拒绝）；false 时退回纯 RAG。
CHAT_AGENT_ENABLED=true
# 是否允许与会议/知识库无关的问题走通用 LLM 直接回答。
CHAT_GENERAL_ANSWERS_ENABLED=true

BGE_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=bge-m3-v1
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BGE_DEVICE=cpu
BGE_BATCH_SIZE=8
# single_pass_pool embeds units once and pools chunk vectors (faster, keeps
# chunk boundaries identical); two_pass keeps the original double-encoding.
BGE_EMBEDDING_STRATEGY=single_pass_pool
BGE_OMP_NUM_THREADS=8
BGE_MKL_NUM_THREADS=8
BGE_OPENBLAS_NUM_THREADS=8
WORKER_CONCURRENCY=1
BGE_MAX_INPUT_CHARACTERS=32000
BGE_RERANKER_QUERY_MAX_LENGTH=128
BGE_RERANKER_MAX_LENGTH=512
MODEL_SERVICE_TIMEOUT_SECONDS=300
FUSION_TOP_K=15
RERANK_TOP_K=5

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
