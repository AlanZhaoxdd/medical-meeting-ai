APP_NAME=医药会议智能分析平台
APP_ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://medical:medical@localhost:5432/medical_meeting
SQL_ECHO=false

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=medical-kb
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=medical_kb_records
MODEL_SERVICE_URL=http://localhost:8100
MODEL_SERVICE_TIMEOUT_SECONDS=300
MODEL_SERVICE_MAX_INPUT_CHARACTERS=32000
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=bge-m3-v1
BGE_DEVICE=cpu
BGE_BATCH_SIZE=4
BGE_OMP_NUM_THREADS=4
BGE_MKL_NUM_THREADS=4
BGE_OPENBLAS_NUM_THREADS=4
WORKER_CONCURRENCY=1
FUSION_TOP_K=15
RERANK_TOP_K=5

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEEPSEEK_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

MAX_UPLOAD_BYTES=52428800
MEETING_IMPORT_STALE_SECONDS=3600
CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100
CHUNK_SIMILARITY_THRESHOLD=0.65
